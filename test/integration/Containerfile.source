# A source image for the integration test.
#
# A real distribution image with a file capability deliberately set, because that
# is the property a rendering test cannot check: whether the copy that filled the
# volume preserved security.capability, or produced a rootfs that looks correct
# and whose unprivileged ping will fail forever.
#
# It also carries an init system, because a machine's source has to be an
# operating system rather than an application image - which is exactly what the
# boot refuses when it is not.
#
# It carries cloud-init and an SSH server, because the provisioning assertions
# have to run against an image that can really run the backend rather than one
# made to look as though it can. The disable marker below is not decoration
# either: the upstream builder writes one into every LXC image this project
# packages, so a fixture without it would let a chart that never removed it go on
# passing while every real machine silently provisioned nothing.
FROM debian:13-slim

RUN apt-get update \
 && apt-get install --assume-yes --no-install-recommends \
      libcap2-bin systemd systemd-sysv cloud-init openssh-server \
 && rm --recursive --force /var/lib/apt/lists/* \
 && : > /etc/cloud/cloud-init.disabled \
 && cp /bin/true /usr/local/bin/sp-probe \
 && setcap cap_net_raw+ep /usr/local/bin/sp-probe \
 && getcap /usr/local/bin/sp-probe | grep --quiet cap_net_raw \
 && echo "seeded-from-oci" > /etc/sp-source-marker
