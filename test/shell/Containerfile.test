# Test environment for the chart's shell scripts. Not shipped, not published:
# it exists so that a developer on a non-Linux host runs the same tests CI does.
FROM debian:13-slim

RUN apt-get update \
 && apt-get install --assume-yes --no-install-recommends \
      bats \
      attr \
      libcap2-bin \
      ca-certificates \
      curl \
      xz-utils \
      zstd \
      gzip \
      jq \
 && rm --recursive --force /var/lib/apt/lists/*

WORKDIR /src
