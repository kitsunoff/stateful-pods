#!/usr/bin/env bash
#
# kubectl machine - reach a machine by the name it was declared under.
#
# The chart runs a machine as a pet with a name, and then the command line hands
# that name back as `<release>-<machine>-0`, a container called `guest`, and a
# shell that might be bash and might only be sh. This closes that gap: a machine
# is addressed by its own name, and the answer to "why can I not get in" is the
# stage it is in rather than an error about a container.
#
# It talks to no API server of its own. Every read is a `kubectl get` and every
# change is a `kubectl` or `helm` invocation, printed before it runs - auth
# plugins, exec credentials and proxies already work through kubectl and none of
# that is reimplementable here. Nothing else is needed: no jq, which is the
# dependency that turns "download one file" into "install two things".
#
# bash 3.2, because macOS ships bash 3.2. No associative arrays, no mapfile, no
# ${var^^}. The macOS job in CI is what holds that; a comment would not.
set -o errexit
set -o nounset
set -o pipefail

SP_VERSION="0.3.1"

# The labels the chart puts on every object it renders for a machine. They are
# also its selector labels, which are immutable for the life of a machine - the
# most stable thing there is to depend on.
# Where the chart is published, and the version of it this plugin drives. A
# plugin whose version has drifted from the chart's would ask a registry for a
# revision that does not exist, so the tag build refuses to publish one without
# the other.
SP_DEFAULT_CHART="oci://ghcr.io/kitsunoff/charts/stateful-pods"

# The labels the chart puts on every object it renders for a machine. They are
# also its selector labels, which are immutable for the life of a machine - the
# most stable thing there is to depend on.
SP_MACHINE_LABEL="stateful-pods.io/machine"
SP_RELEASE_LABEL="app.kubernetes.io/instance"

# The container a machine's own operating system runs in, and the init containers
# it passes through on the way there, in the order it passes through them.
SP_GUEST="guest"
SP_INIT_STEPS="seed prepare customize provision"

SP_PROGRAM="kubectl machine"

# Set by the global flags, and used by every command.
SP_NAMESPACE=""
SP_CONTEXT=""
SP_RELEASE=""

die() {
    printf '%s\n' "$*" >&2
    exit 1
}

# One argument of a printed command, quoted when it would not survive being
# pasted back into a shell. The plugin prints what it runs so that a reader
# learns the underlying invocation, and a printed command that cannot be run
# teaches the wrong one - `-- sh -c echo hello; uname` is not what was run.
quote_arg() {
    case "$1" in
        "") printf "''" ;;
        *[!A-Za-z0-9_@%+=:,./-]*) printf "'%s'" "${1//\'/\'\\\'\'}" ;;
        *) printf '%s' "$1" ;;
    esac
}

# Prints a command in the form it is about to be run in. On stderr, so that what
# the command itself produces stays pipeable.
show_command() {
    local line="" arg
    for arg in "$@"; do
        line="$line $(quote_arg "$arg")"
    done
    printf '==>%s\n' "$line" >&2
}

usage() {
    cat <<EOF
$SP_PROGRAM - work with the machines a stateful-pods release runs

Usage:
  kubectl machine list                    the machines in a namespace, and the stage each is in
  kubectl machine status <name>           where one machine is in its life
  kubectl machine shell <name> [-- cmd]   a shell inside the machine
  kubectl machine console <name>          the machine's own boot output
  kubectl machine create <name> [flags]   install a machine
  kubectl machine delete <name>           remove a machine's release, keeping its root filesystem
  kubectl machine version                 the plugin's version

Flags shared by every command:
  --namespace <namespace>   the namespace to act in (default: the context's)
  --context <context>       the cluster context to act in (default: the current one)
  --release <release>       the release the machine belongs to, when its name is ambiguous
  --help                    this text, or a command's own

Run 'kubectl machine <command> --help' for what a command takes.
EOF
}

# ---------------------------------------------------------------------------
# What has to be true before anything is attempted
# ---------------------------------------------------------------------------

# A platform check that runs first, so that an unsupported platform is stated
# rather than discovered half-way through a create. There is no bash on Windows
# worth targeting; that trade was accepted when this was written in bash rather
# than Go, and it is recorded here instead of being papered over.
require_platform() {
    local system
    system="$(uname -s 2>/dev/null || echo unknown)"
    case "$system" in
        Linux | Darwin | *BSD) ;;
        *)
            die "$SP_PROGRAM does not support $system: it is a bash program, and it supports Linux and macOS.
On Windows, run it from WSL."
            ;;
    esac
}

require_tool() {
    command -v "$1" >/dev/null 2>&1 ||
        die "$SP_PROGRAM needs $1, which was not found on PATH.
$2"
}

require_kubectl() {
    require_tool kubectl "Install it: https://kubernetes.io/docs/tasks/tools/"
}

require_helm() {
    require_tool helm "Install it: https://helm.sh/docs/intro/install/"
}

# ---------------------------------------------------------------------------
# Flag parsing
#
# Written out rather than delegated to getopt: the long flags this composes are
# the ones it prints, and getopt on macOS is the BSD one, which has no long
# flags at all.
# ---------------------------------------------------------------------------

SP_FLAG=""
SP_VALUE=""
SP_HAS_VALUE=0
SP_SHIFT=0

# Splits --flag=value into its parts, so both spellings work everywhere.
flag_split() {
    SP_SHIFT=1
    case "$1" in
        --*=*)
            SP_FLAG="${1%%=*}"
            SP_VALUE="${1#*=}"
            SP_HAS_VALUE=1
            ;;
        *)
            SP_FLAG="$1"
            SP_VALUE=""
            SP_HAS_VALUE=0
            ;;
    esac
}

# The value of a flag that needs one, taken from the next argument when it was
# not given with an equals sign. Called with the arguments still to be parsed.
flag_value() {
    [ "$SP_HAS_VALUE" -eq 1 ] && return 0
    [ "$#" -ge 2 ] || die "$SP_FLAG needs a value"
    SP_VALUE="$2"
    SP_SHIFT=2
}

# The flags every command takes. Returns 0 when it consumed the flag.
common_flag() {
    case "$SP_FLAG" in
        --namespace)
            flag_value "$@"
            SP_NAMESPACE="$SP_VALUE"
            ;;
        --context)
            flag_value "$@"
            SP_CONTEXT="$SP_VALUE"
            ;;
        --release)
            flag_value "$@"
            SP_RELEASE="$SP_VALUE"
            ;;
        *) return 1 ;;
    esac
    return 0
}

# ---------------------------------------------------------------------------
# Talking to the cluster
# ---------------------------------------------------------------------------

# The context and namespace flags, in the form they are passed and printed.
kube_flags() {
    [ -n "$SP_CONTEXT" ] && printf ' --context %s' "$SP_CONTEXT"
    [ -n "$SP_NAMESPACE" ] && printf ' --namespace %s' "$SP_NAMESPACE"
    return 0
}

# The same flags as an array, for running and for printing. Set rather than
# returned, because bash 3.2 has no way to return one.
SP_KUBE_FLAGS=()
set_kube_flags() {
    SP_KUBE_FLAGS=()
    [ -n "$SP_CONTEXT" ] && SP_KUBE_FLAGS+=(--context "$SP_CONTEXT")
    [ -n "$SP_NAMESPACE" ] && SP_KUBE_FLAGS+=(--namespace "$SP_NAMESPACE")
    return 0
}

kubectl_run() {
    set_kube_flags
    kubectl ${SP_KUBE_FLAGS[@]+"${SP_KUBE_FLAGS[@]}"} "$@"
}

current_context() {
    if [ -n "$SP_CONTEXT" ]; then
        printf '%s\n' "$SP_CONTEXT"
    else
        kubectl config current-context 2>/dev/null || printf '%s\n' "(none)"
    fi
}

# The selector for one machine, narrowed by release when one was named.
machine_selector() {
    if [ -n "$SP_RELEASE" ]; then
        printf '%s=%s,%s=%s' "$SP_MACHINE_LABEL" "$1" "$SP_RELEASE_LABEL" "$SP_RELEASE"
    else
        printf '%s=%s' "$SP_MACHINE_LABEL" "$1"
    fi
}

# The selector for the machine that was resolved, narrowed by the release it was
# found in rather than by whether the user happened to type --release. Every read
# after resolution uses this. A pod or a claim another release left behind
# carries the same machine label - the plugin's own retention is what creates
# that - and deciding which machine is meant is exactly what resolving did.
resolved_selector() {
    printf '%s=%s,%s=%s' "$SP_MACHINE_LABEL" "$SP_MACHINE" "$SP_RELEASE_LABEL" "$SP_MACHINE_RELEASE"
}

# The projections below are separated by a vertical bar rather than a tab, and
# that is not a taste. Bash treats a tab as IFS whitespace even when IFS is set
# to a tab alone, so two of them in a row collapse into one delimiter - and a
# machine with no init containers, whose init field is empty, would have every
# field after it shifted along by one and be reported as pending while it runs.
# None of the values here can contain a bar: they are label values, DNS names,
# CamelCase reasons and digits.

# Every machine's statefulset, projected to: name, release, object name.
STS_TEMPLATE='{{range .items}}{{index .metadata.labels "stateful-pods.io/machine"}}{{"|"}}{{index .metadata.labels "app.kubernetes.io/instance"}}{{"|"}}{{.metadata.name}}{{"\n"}}{{end}}'

# Every machine's pod, projected to: name, release, pod, phase, the init
# containers' states, the containers' states. A container is encoded as
# NAME=STATE,REASON,EXITCODE,READY - which is everything the stage derivation
# below reads, and nothing that needs jq to get at.
POD_TEMPLATE='{{range .items}}{{index .metadata.labels "stateful-pods.io/machine"}}{{"|"}}{{index .metadata.labels "app.kubernetes.io/instance"}}{{"|"}}{{.metadata.name}}{{"|"}}{{.status.phase}}{{"|"}}{{range .status.initContainerStatuses}}{{.name}}={{if .state.running}}running,,,{{else if .state.terminated}}terminated,{{.state.terminated.reason}},{{.state.terminated.exitCode}},{{else if .state.waiting}}waiting,{{.state.waiting.reason}},,{{else}}unknown,,,{{end}}{{.ready}};{{end}}{{"|"}}{{range .status.containerStatuses}}{{.name}}={{if .state.running}}running,,,{{else if .state.terminated}}terminated,{{.state.terminated.reason}},{{.state.terminated.exitCode}},{{else if .state.waiting}}waiting,{{.state.waiting.reason}},,{{else}}unknown,,,{{end}}{{.ready}};{{end}}{{"\n"}}{{end}}'

get_statefulsets() {
    kubectl_run get statefulsets --selector "$1" --output "go-template=$STS_TEMPLATE"
}

get_pods() {
    kubectl_run get pods --selector "$1" --output "go-template=$POD_TEMPLATE"
}

# A read that failed is not an empty answer. Without this, a cluster that cannot
# be reached - a context that does not exist, a namespace with no access - is
# reported as a namespace with no machines in it, which is the same confidently
# wrong answer that "cannot exec into container guest" is, one level up.
#
# It has to be said at the call site rather than inside the read: a read happens
# inside a command substitution, and exiting from there ends the substitution
# rather than the program.
read_failed() {
    die "kubectl could not read the machines in $(where_it_would_act); its own error is above."
}

# ---------------------------------------------------------------------------
# Resolving a name
#
# By label, and never by rebuilding the chart's naming rule: a user who has to
# know that rule has been handed the chart's internals as an interface. Two
# releases in a namespace can each declare a machine called `web`, so more than
# one match stops rather than picking - picking the wrong pet is the one mistake
# this must not make.
# ---------------------------------------------------------------------------

SP_MACHINE=""
SP_MACHINE_RELEASE=""
SP_OBJECT=""
# What the resolving read returned, kept so that reporting an ambiguous name does
# not ask the same question a second time.
SP_MATCHES=""

resolve_machine() {
    local name="$1" found=0 machine release object
    # Through a variable rather than a process substitution: the exit status of
    # the read is lost in one, and losing it is how a failure becomes an answer.
    SP_MATCHES="$(get_statefulsets "$(machine_selector "$name")")" || read_failed
    while IFS='|' read -r machine release object || [ -n "$machine" ]; do
        [ -n "$machine" ] || continue
        found=$((found + 1))
        SP_MACHINE="$machine"
        SP_MACHINE_RELEASE="$release"
        SP_OBJECT="$object"
    done <<EOF
$SP_MATCHES
EOF

    if [ "$found" -eq 0 ]; then
        report_unknown "$name"
    fi
    if [ "$found" -gt 1 ]; then
        report_ambiguous "$name"
    fi
}

report_unknown() {
    local name="$1" listing="" other release stage rows
    # Not inside the heredoc: a read there happens in a command substitution, and
    # exiting from there ends the substitution rather than the program - which
    # would print the failure and then contradict it with an answer.
    rows="$(machine_rows)" || read_failed
    while IFS='|' read -r other release stage _ || [ -n "$other" ]; do
        [ -n "$other" ] || continue
        listing="$listing  $other in release $release ($stage)
"
    done <<EOF
$rows
EOF
    if [ -n "$listing" ]; then
        die "no machine called $name in $(where_it_would_act). These are there:
$listing"
    fi
    die "no machine called $name in $(where_it_would_act), and no machines at all."
}

report_ambiguous() {
    local name="$1" machine release object matches=""
    while IFS='|' read -r machine release object || [ -n "$machine" ]; do
        [ -n "$machine" ] || continue
        matches="$matches  $machine in release $release ($object)
"
    done <<EOF
$SP_MATCHES
EOF
    die "more than one machine is called $name in $(where_it_would_act):
$matches
Name the release it belongs to with --release, so that the right one is acted on."
}

# Where a message about "everything here" is true of. Once --release narrows what
# is read, saying "there are no machines in namespace homelab" is a claim about
# the namespace that the plugin did not look at and that is very likely false -
# which is the same class of confidently wrong statement about the cluster that
# this plugin exists to stop making.
where_it_would_act() {
    local scope=""
    [ -n "$SP_RELEASE" ] && scope="release $SP_RELEASE in "
    if [ -n "$SP_NAMESPACE" ]; then
        printf '%snamespace %s' "$scope" "$SP_NAMESPACE"
    else
        printf '%sthe current namespace' "$scope"
    fi
}

# ---------------------------------------------------------------------------
# The stage a machine is in
#
# Read from that machine's own pod status and from nothing else. Every row of
# this is a state the chart produces; none of it is inferred from how long
# something has been happening, because a large template legitimately takes
# minutes and a timer would report a healthy machine as broken.
# ---------------------------------------------------------------------------

SP_STAGE=""          # one word, for a listing
SP_STAGE_TEXT=""     # what it means, for a person
SP_STAGE_CONTAINER="" # the container whose output explains it
SP_STAGE_DETAIL=""   # why, when a stage is a failure
SP_STAGE_ENTERABLE=0 # whether the machine's own operating system is running in it

# The state of one container out of a projected `name=state,reason,exit,ready;`
# list. Sets SP_CS_STATE, SP_CS_REASON, SP_CS_EXIT and SP_CS_READY.
SP_CS_STATE=""
SP_CS_REASON=""
SP_CS_EXIT=""
SP_CS_READY=""

container_state() {
    local wanted="$1" list="$2" entry rest
    SP_CS_STATE=""
    SP_CS_REASON=""
    SP_CS_EXIT=""
    SP_CS_READY=""
    while [ -n "$list" ]; do
        entry="${list%%;*}"
        if [ "$entry" = "$list" ]; then
            list=""
        else
            list="${list#*;}"
        fi
        [ -n "$entry" ] || continue
        case "$entry" in
            "$wanted"=*)
                rest="${entry#*=}"
                SP_CS_STATE="${rest%%,*}"
                rest="${rest#*,}"
                SP_CS_REASON="${rest%%,*}"
                rest="${rest#*,}"
                SP_CS_EXIT="${rest%%,*}"
                SP_CS_READY="${rest#*,}"
                return 0
                ;;
        esac
    done
    return 1
}

step_stage() {
    case "$1" in
        seed) printf 'seeding' ;;
        prepare) printf 'preparing' ;;
        customize) printf 'customizing' ;;
        provision) printf 'provisioning' ;;
        *) printf '%s' "$1" ;;
    esac
}

step_text() {
    case "$1" in
        seed) printf 'seeding the root filesystem from its source' ;;
        prepare) printf "preparing the machine's identity" ;;
        customize) printf 'writing the files the chart maintains' ;;
        provision) printf 'provisioning the guest' ;;
        *) printf 'running %s' "$1" ;;
    esac
}

# A waiting reason that is a failure rather than a step that has not begun.
waiting_is_failure() {
    case "$1" in
        PodInitializing | ContainerCreating | "" | Pending) return 1 ;;
        *) return 0 ;;
    esac
}

# Derives the stage from a projected pod line's init and container states.
derive_stage() {
    local inits="$1" containers="$2" step

    SP_STAGE=""
    SP_STAGE_TEXT=""
    SP_STAGE_CONTAINER=""
    SP_STAGE_DETAIL=""
    SP_STAGE_ENTERABLE=0

    for step in $SP_INIT_STEPS; do
        container_state "$step" "$inits" || continue
        case "$SP_CS_STATE" in
            terminated)
                [ "$SP_CS_EXIT" = "0" ] && continue
                SP_STAGE="failed"
                SP_STAGE_TEXT="failed while $(step_text "$step")"
                SP_STAGE_CONTAINER="$step"
                SP_STAGE_DETAIL="it exited with code $SP_CS_EXIT"
                return 0
                ;;
            running)
                SP_STAGE="$(step_stage "$step")"
                SP_STAGE_TEXT="$(step_text "$step")"
                SP_STAGE_CONTAINER="$step"
                return 0
                ;;
            waiting)
                if waiting_is_failure "$SP_CS_REASON"; then
                    SP_STAGE="failed"
                    SP_STAGE_TEXT="failed while $(step_text "$step")"
                    SP_STAGE_CONTAINER="$step"
                    SP_STAGE_DETAIL="the container is $SP_CS_REASON"
                else
                    SP_STAGE="$(step_stage "$step")"
                    SP_STAGE_TEXT="$(step_text "$step")"
                    SP_STAGE_CONTAINER="$step"
                fi
                return 0
                ;;
        esac
    done

    if container_state "$SP_GUEST" "$containers"; then
        case "$SP_CS_STATE" in
            running)
                SP_STAGE_CONTAINER="$SP_GUEST"
                # Running is what makes a shell reachable. Ready is a statement
                # about the operating system inside having finished starting,
                # and waiting for it would lock a user out of exactly the machine
                # they need to look at.
                SP_STAGE_ENTERABLE=1
                if [ "$SP_CS_READY" = "true" ]; then
                    SP_STAGE="ready"
                    SP_STAGE_TEXT="ready - its operating system has finished starting"
                else
                    SP_STAGE="booting"
                    SP_STAGE_TEXT="booting - its operating system is still starting"
                fi
                ;;
            terminated)
                SP_STAGE_CONTAINER="$SP_GUEST"
                if [ "$SP_CS_EXIT" = "0" ]; then
                    SP_STAGE="stopped"
                    SP_STAGE_TEXT="stopped - the $SP_GUEST container exited"
                else
                    SP_STAGE="failed"
                    SP_STAGE_TEXT="failed - the $SP_GUEST container exited with code $SP_CS_EXIT"
                fi
                ;;
            waiting)
                SP_STAGE_CONTAINER="$SP_GUEST"
                if waiting_is_failure "$SP_CS_REASON"; then
                    SP_STAGE="failed"
                    SP_STAGE_TEXT="failed - the $SP_GUEST container is $SP_CS_REASON"
                else
                    SP_STAGE="booting"
                    SP_STAGE_TEXT="booting - the $SP_GUEST container is starting"
                fi
                ;;
            *)
                SP_STAGE="pending"
                SP_STAGE_TEXT="pending - the $SP_GUEST container has no state yet"
                ;;
        esac
        return 0
    fi

    # A pod that exists with nothing started in it. Not a row of the table, and
    # deliberately not folded into one: calling it "seeding" would be a stage
    # invented rather than read, and the answer is in the pod's events.
    SP_STAGE="pending"
    SP_STAGE_TEXT="pending - nothing has started in its pod yet"
    return 0
}

# The stage, said once. Most of the sentences name their own stage - "booting -
# its operating system is still starting" - and the two that do not are the init
# steps, whose stage is a word about the machine and whose sentence is about what
# is being done to it.
stage_sentence() {
    case "$SP_STAGE_TEXT" in
        "$SP_STAGE"*) printf '%s' "$SP_STAGE_TEXT" ;;
        *) printf '%s - %s' "$SP_STAGE" "$SP_STAGE_TEXT" ;;
    esac
}

# What to read to understand the stage a machine is in.
stage_hint() {
    local pod="$1"
    case "$SP_STAGE" in
        pending)
            printf 'kubectl%s describe pod %s' "$(kube_flags)" "$pod"
            ;;
        stopped | failed)
            if [ "$SP_STAGE_CONTAINER" = "$SP_GUEST" ]; then
                printf 'kubectl%s logs %s --container %s --previous' "$(kube_flags)" "$pod" "$SP_GUEST"
            else
                printf 'kubectl%s logs %s --container %s' "$(kube_flags)" "$pod" "$SP_STAGE_CONTAINER"
            fi
            ;;
        *)
            printf 'kubectl%s logs %s --container %s --follow' "$(kube_flags)" "$pod" "$SP_STAGE_CONTAINER"
            ;;
    esac
}

# ---------------------------------------------------------------------------
# Reading a machine's pod
# ---------------------------------------------------------------------------

SP_POD=""

# Fills SP_POD and the stage variables for the resolved machine. Reports whether
# a pod was found at all.
read_machine_pod() {
    local machine release pod inits containers found=0 pods
    SP_POD=""
    pods="$(get_pods "$(resolved_selector)")" || read_failed
    while IFS='|' read -r machine release pod _ inits containers || [ -n "$machine" ]; do
        [ -n "$machine" ] || continue
        SP_POD="$pod"
        derive_stage "$inits" "$containers"
        found=1
    done <<EOF
$pods
EOF
    [ "$found" -eq 1 ]
}

# ---------------------------------------------------------------------------
# list
# ---------------------------------------------------------------------------

list_help() {
    cat <<EOF
kubectl machine list - the machines in a namespace, and the stage each is in

Usage:
  kubectl machine list [--namespace <namespace>] [--context <context>]
EOF
}

# One row per machine: name, release, stage, object name, tab separated.
# Machines whose pod has not been created yet still appear, because a machine a
# release declares is a machine that exists.
machine_rows() {
    local machine release object inits containers stage
    local pods="" sets="" line line_release selector
    # The label on its own lists every machine here. --release narrows that, and
    # is advertised as a flag every command takes, so it has to mean something
    # here too.
    selector="$SP_MACHINE_LABEL"
    [ -n "$SP_RELEASE" ] && selector="$SP_MACHINE_LABEL,$SP_RELEASE_LABEL=$SP_RELEASE"
    # Reported by the caller, which is in the shell that can act on it.
    pods="$(get_pods "$selector")" || return 1
    sets="$(get_statefulsets "$selector")" || return 1
    while IFS='|' read -r machine release object || [ -n "$machine" ]; do
        [ -n "$machine" ] || continue
        stage="not running"
        while IFS='|' read -r line line_release _ _ inits containers || [ -n "$line" ]; do
            # Both, because two releases here can each declare a machine called
            # `web`, and matching on the name alone gives them both whichever
            # pod was read last.
            [ "$line" = "$machine" ] || continue
            [ "$line_release" = "$release" ] || continue
            derive_stage "$inits" "$containers"
            stage="$SP_STAGE"
        done <<EOF
$pods
EOF
        printf '%s|%s|%s|%s\n' "$machine" "$release" "$stage" "$object"
    done <<EOF
$sets
EOF
}

cmd_list() {
    while [ "$#" -gt 0 ]; do
        flag_split "$1"
        case "$SP_FLAG" in
            --help)
                list_help
                return 0
                ;;
            --*)
                common_flag "$@" || die "unknown flag for list: $SP_FLAG"
                ;;
            *)
                die "list takes no machine name; it lists them all.
Did you mean: kubectl machine status $SP_FLAG"
                ;;
        esac
        shift "$SP_SHIFT"
    done
    require_kubectl

    local rows name release stage object
    local name_width=4 release_width=7 stage_width=5
    rows="$(machine_rows)" || read_failed
    if [ -z "$rows" ]; then
        printf 'There are no machines in %s.\n' "$(where_it_would_act)"
        return 0
    fi
    while IFS='|' read -r name release stage object || [ -n "$name" ]; do
        [ -n "$name" ] || continue
        [ "${#name}" -gt "$name_width" ] && name_width="${#name}"
        [ "${#release}" -gt "$release_width" ] && release_width="${#release}"
        [ "${#stage}" -gt "$stage_width" ] && stage_width="${#stage}"
    done <<EOF
$rows
EOF
    printf '%-*s  %-*s  %-*s  %s\n' \
        "$name_width" NAME "$release_width" RELEASE "$stage_width" STAGE OBJECT
    while IFS='|' read -r name release stage object || [ -n "$name" ]; do
        [ -n "$name" ] || continue
        printf '%-*s  %-*s  %-*s  %s\n' \
            "$name_width" "$name" "$release_width" "$release" "$stage_width" "$stage" "$object"
    done <<EOF
$rows
EOF
}

# ---------------------------------------------------------------------------
# status
# ---------------------------------------------------------------------------

status_help() {
    cat <<EOF
kubectl machine status <name> - where one machine is in its life

Usage:
  kubectl machine status <name> [--release <release>] [--namespace <namespace>]
EOF
}

cmd_status() {
    local name=""
    while [ "$#" -gt 0 ]; do
        flag_split "$1"
        case "$SP_FLAG" in
            --help)
                status_help
                return 0
                ;;
            --*)
                common_flag "$@" || die "unknown flag for status: $SP_FLAG"
                ;;
            *)
                [ -z "$name" ] || die "status takes one machine, and was given $name and $SP_FLAG"
                name="$SP_FLAG"
                ;;
        esac
        shift "$SP_SHIFT"
    done
    [ -n "$name" ] || die "status needs a machine's name. Run 'kubectl machine list' to see them."
    require_kubectl
    resolve_machine "$name"

    printf 'Machine:    %s\n' "$SP_MACHINE"
    printf 'Release:    %s\n' "$SP_MACHINE_RELEASE"
    printf 'Objects:    %s\n' "$SP_OBJECT"
    printf 'Namespace:  %s\n' "${SP_NAMESPACE:-(the one the context names)}"
    printf 'Context:    %s\n' "$(current_context)"

    if ! read_machine_pod; then
        printf 'Stage:      not running - its release %s is installed, but it has no pod\n' "$SP_MACHINE_RELEASE"
        printf '\n  kubectl%s describe statefulset %s\n' "$(kube_flags)" "$SP_OBJECT"
        return 0
    fi

    printf 'Pod:        %s\n' "$SP_POD"
    printf 'Stage:      %s\n' "$(stage_sentence)"
    [ -n "$SP_STAGE_DETAIL" ] && printf 'Because:    %s\n' "$SP_STAGE_DETAIL"
    printf '\n  %s\n' "$(stage_hint "$SP_POD")"
    return 0
}

# ---------------------------------------------------------------------------
# shell
# ---------------------------------------------------------------------------

shell_help() {
    cat <<EOF
kubectl machine shell <name> - a shell inside the machine

Usage:
  kubectl machine shell <name> [--release <release>] [--namespace <namespace>] [-- <command>]

Flags:
  --tty / --no-tty   allocate a terminal, or do not (default: when there is one)
  -- <command>       run this inside the machine instead of opening a shell

The shell is chosen inside the machine: /bin/sh exists in every root filesystem
the chart can seed, and bash does not - Alpine and Void do not ship it.
EOF
}

# What is run inside the machine when no command was given. One round trip: the
# choice is made in the machine, by the machine, rather than probed for first.
SP_SHELL_CHOOSER='if command -v bash >/dev/null 2>&1; then exec bash --login; else exec sh; fi'

# Says where a machine cannot be entered and what explains the wait, rather than
# handing back an error about a container. This is the whole reason the plugin
# exists.
refuse_with_stage() {
    local verb="$1"
    printf '%s: %s.\n' "$SP_MACHINE" "$(stage_sentence)" >&2
    [ -n "$SP_STAGE_DETAIL" ] && printf 'Because: %s\n' "$SP_STAGE_DETAIL" >&2
    printf '\nThere is nothing to %s yet. This is what explains it:\n\n  %s\n' \
        "$verb" "$(stage_hint "$SP_POD")" >&2
    exit 1
}

# A machine whose release exists but whose pod does not.
refuse_without_pod() {
    printf '%s is not running: its release %s is installed, but it has no pod.\n' \
        "$SP_MACHINE" "$SP_MACHINE_RELEASE" >&2
    printf '\n  kubectl%s describe statefulset %s\n' "$(kube_flags)" "$SP_OBJECT" >&2
    exit 1
}

cmd_shell() {
    local name="" tty="auto"
    local command=()
    while [ "$#" -gt 0 ]; do
        if [ "$1" = "--" ]; then
            shift
            command=("$@")
            break
        fi
        flag_split "$1"
        case "$SP_FLAG" in
            --help)
                shell_help
                return 0
                ;;
            --tty) tty="yes" ;;
            --no-tty) tty="no" ;;
            --*)
                common_flag "$@" || die "unknown flag for shell: $SP_FLAG"
                ;;
            *)
                [ -z "$name" ] || die "shell takes one machine, and was given $name and $SP_FLAG"
                name="$SP_FLAG"
                ;;
        esac
        shift "$SP_SHIFT"
    done
    [ -n "$name" ] || die "shell needs a machine's name. Run 'kubectl machine list' to see them."
    require_kubectl
    resolve_machine "$name"
    read_machine_pod || refuse_without_pod
    [ "$SP_STAGE_ENTERABLE" -eq 1 ] || refuse_with_stage "enter"

    local exec_flags=(--stdin)
    case "$tty" in
        yes) exec_flags+=(--tty) ;;
        no) ;;
        *) [ -t 0 ] && [ -t 1 ] && exec_flags+=(--tty) ;;
    esac

    local target=("$SP_POD" --container "$SP_GUEST" --)
    if [ "${#command[@]}" -eq 0 ]; then
        target+=(/bin/sh -c "$SP_SHELL_CHOOSER")
    else
        target+=("${command[@]}")
    fi

    printf 'Entering %s (%s) in %s, on context %s.\n' \
        "$SP_MACHINE" "$SP_POD" "$(where_it_would_act)" "$(current_context)" >&2
    set_kube_flags
    show_command kubectl ${SP_KUBE_FLAGS[@]+"${SP_KUBE_FLAGS[@]}"} exec "${exec_flags[@]}" "${target[@]}"
    kubectl_run exec "${exec_flags[@]}" "${target[@]}"
}

# ---------------------------------------------------------------------------
# console
# ---------------------------------------------------------------------------

console_help() {
    cat <<EOF
kubectl machine console <name> - the machine's own boot output

Usage:
  kubectl machine console <name> [--follow] [--tail <lines>] [--previous]

The console is what the guest container's logs are: the output of the machine's
own init system, from the first line it printed.
EOF
}

cmd_console() {
    local name="" follow=0 previous=0 tail=""
    while [ "$#" -gt 0 ]; do
        flag_split "$1"
        case "$SP_FLAG" in
            --help)
                console_help
                return 0
                ;;
            --follow) follow=1 ;;
            --previous) previous=1 ;;
            --tail)
                flag_value "$@"
                tail="$SP_VALUE"
                ;;
            --*)
                common_flag "$@" || die "unknown flag for console: $SP_FLAG"
                ;;
            *)
                [ -z "$name" ] || die "console takes one machine, and was given $name and $SP_FLAG"
                name="$SP_FLAG"
                ;;
        esac
        shift "$SP_SHIFT"
    done
    [ -n "$name" ] || die "console needs a machine's name. Run 'kubectl machine list' to see them."
    require_kubectl
    resolve_machine "$name"
    read_machine_pod || refuse_without_pod

    # The guest container is where a machine's own output is. Before it starts
    # there is no console to read, and saying which step is still running is a
    # better answer than an empty log.
    [ "$SP_STAGE_CONTAINER" = "$SP_GUEST" ] || refuse_with_stage "read"

    local args=("$SP_POD" --container "$SP_GUEST")
    [ "$previous" -eq 1 ] && args+=(--previous)
    [ -n "$tail" ] && args+=(--tail "$tail")
    [ "$follow" -eq 1 ] && args+=(--follow)

    set_kube_flags
    show_command kubectl ${SP_KUBE_FLAGS[@]+"${SP_KUBE_FLAGS[@]}"} logs "${args[@]}"
    kubectl_run logs "${args[@]}"
}

# ---------------------------------------------------------------------------
# create
#
# Composes values and hands them to Helm. It checks none of them. The chart
# refuses to guess a security mode or a source and its rejections name the values
# path and the accepted set; a second validator here would drift from that one,
# and a default invented here would be a machine configured by a tool rather than
# by its owner.
# ---------------------------------------------------------------------------

create_help() {
    cat <<EOF
kubectl machine create <name> - install a machine

Usage:
  kubectl machine create <name> --preset <preset> --mode <mode> [flags]
  kubectl machine create <name> --source-oci <reference> --mode <mode> [flags]
  kubectl machine create <name> --source-lxc-url <url> --source-sha256 <digest> --mode <mode> [flags]

Source, one of:
  --preset <name>            a root filesystem this project publishes and pins
  --source-oci <reference>   an image to unpack into the root filesystem
  --source-lxc-url <url>     a template tarball, with --source-sha256

Machine:
  --mode <mode>              the privilege level, as the chart names them
  --source-sha256 <digest>   the checksum an lxc template must match
  --size <size>              the root filesystem's size
  --storage-class <class>    the storage class to create it from
  --hostname <hostname>      the hostname inside the machine
  --pull-secret <name>       a dockerconfigjson secret for a private source

Release:
  --release <release>        the release to install into (default: the machine's name)
  --chart <chart>            the chart to install (default: $SP_DEFAULT_CHART)
  --version <version>        the chart version (default: $SP_VERSION)
  --set <key=value>          passed to helm unchanged, repeatable
  --values <file>            passed to helm unchanged, repeatable

Nothing above is validated here. Every input goes to the chart, and what comes
back when one is wrong is the chart's own message.
EOF
}

# Whether a helm failure was the chart refusing the values or helm never getting
# hold of the chart at all. Only the second is worth advice, and a rejection the
# chart wrote must not be buried under it.
looks_like_an_unresolvable_chart() {
    case "$1" in
        *"execution error at"* | *"template:"*) return 1 ;;
    esac
    case "$1" in
        *"failed to download"* | *"failed to pull"* | *"not found"* | *"no such host"* | \
            *unauthorized* | *"access denied"* | *"failed to authorize"*) return 0 ;;
    esac
    return 1
}

cmd_create() {
    local name="" chart="" version="" mode="" size="" storage_class="" hostname=""
    local pull_secret="" preset="" oci="" lxc_url="" sha256="" sources=0
    local passthrough=()

    while [ "$#" -gt 0 ]; do
        flag_split "$1"
        case "$SP_FLAG" in
            --help)
                create_help
                return 0
                ;;
            --preset)
                flag_value "$@"
                preset="$SP_VALUE"
                sources=$((sources + 1))
                ;;
            --source-oci)
                flag_value "$@"
                oci="$SP_VALUE"
                sources=$((sources + 1))
                ;;
            --source-lxc-url)
                flag_value "$@"
                lxc_url="$SP_VALUE"
                sources=$((sources + 1))
                ;;
            --source-sha256)
                flag_value "$@"
                sha256="$SP_VALUE"
                ;;
            --mode)
                flag_value "$@"
                mode="$SP_VALUE"
                ;;
            --size)
                flag_value "$@"
                size="$SP_VALUE"
                ;;
            --storage-class)
                flag_value "$@"
                storage_class="$SP_VALUE"
                ;;
            --hostname)
                flag_value "$@"
                hostname="$SP_VALUE"
                ;;
            --pull-secret)
                flag_value "$@"
                pull_secret="$SP_VALUE"
                ;;
            --chart)
                flag_value "$@"
                chart="$SP_VALUE"
                ;;
            --version)
                flag_value "$@"
                version="$SP_VALUE"
                ;;
            --set)
                flag_value "$@"
                passthrough+=(--set "$SP_VALUE")
                ;;
            --values)
                flag_value "$@"
                passthrough+=(--values "$SP_VALUE")
                ;;
            --*)
                common_flag "$@" || die "unknown flag for create: $SP_FLAG"
                ;;
            *)
                [ -z "$name" ] || die "create takes one machine, and was given $name and $SP_FLAG"
                name="$SP_FLAG"
                ;;
        esac
        shift "$SP_SHIFT"
    done

    [ -n "$name" ] || die "create needs a name for the machine.

$(create_help)"
    # The one thing checked here, because these flags contradict each other
    # rather than being wrong: the chart would only ever see the last one.
    [ "$sources" -le 1 ] ||
        die "a machine has one source: name it with --preset, --source-oci or --source-lxc-url, not more than one."
    require_helm

    local release="${SP_RELEASE:-$name}"
    local values=()
    [ -n "$preset" ] && values+=(--set-string "machines.$name.source.kind=preset" \
        --set-string "machines.$name.source.name=$preset")
    [ -n "$oci" ] && values+=(--set-string "machines.$name.source.kind=oci" \
        --set-string "machines.$name.source.reference=$oci")
    [ -n "$lxc_url" ] && values+=(--set-string "machines.$name.source.kind=lxc" \
        --set-string "machines.$name.source.url=$lxc_url")
    # --set-string throughout, and this is the reason: a checksum of nothing but
    # digits is a number to a values parser, and a number is not a checksum by
    # the time the chart reads it.
    [ -n "$sha256" ] && values+=(--set-string "machines.$name.source.sha256=$sha256")
    [ -n "$pull_secret" ] && values+=(--set-string "machines.$name.source.pullSecretName=$pull_secret")
    [ -n "$mode" ] && values+=(--set-string "machines.$name.security.mode=$mode")
    [ -n "$size" ] && values+=(--set-string "machines.$name.rootfs.size=$size")
    [ -n "$storage_class" ] && values+=(--set-string "machines.$name.rootfs.storageClassName=$storage_class")
    [ -n "$hostname" ] && values+=(--set-string "machines.$name.hostname=$hostname")

    local args=(upgrade --install "$release" "${chart:-$SP_DEFAULT_CHART}")
    [ -n "$SP_CONTEXT" ] && args+=(--kube-context "$SP_CONTEXT")
    [ -n "$SP_NAMESPACE" ] && args+=(--namespace "$SP_NAMESPACE")
    # Only for a reference that has to be resolved: a chart taken off the
    # filesystem is whatever is on the filesystem, and asking for a version of it
    # would refuse a checkout that is mid-development.
    case "${chart:-$SP_DEFAULT_CHART}" in
        oci://* | http://* | https://*) args+=(--version "${version:-$SP_VERSION}") ;;
        *) [ -n "$version" ] && args+=(--version "$version") ;;
    esac
    args+=(${values[@]+"${values[@]}"} ${passthrough[@]+"${passthrough[@]}"})

    printf 'Context:    %s\n' "$(current_context)"
    printf 'Namespace:  %s\n' "${SP_NAMESPACE:-(the one the context names)}"
    printf 'Machine:    %s\n' "$name"
    printf 'Release:    %s\n' "$release"
    printf 'Objects:    %s\n' "$release-$name"
    show_command helm "${args[@]}"

    local out rc=0
    if out="$(helm "${args[@]}" 2>&1)"; then
        [ -n "$out" ] && printf '%s\n' "$out"
        return 0
    else
        rc=$?
    fi
    # The chart's own rejection, unchanged and unabridged.
    printf '%s\n' "$out" >&2
    if looks_like_an_unresolvable_chart "$out"; then
        printf '\nHelm could not get hold of the chart itself. Until a chart is published at
%s, install from a checkout instead:

  kubectl machine create %s --chart <path to charts/stateful-pods> ...\n' \
            "${chart:-$SP_DEFAULT_CHART}" "$name" >&2
    fi
    return "$rc"
}

# ---------------------------------------------------------------------------
# delete
# ---------------------------------------------------------------------------

delete_help() {
    cat <<EOF
kubectl machine delete <name> - remove a machine's release

Usage:
  kubectl machine delete <name> [--release <release>] [--yes]

Flags:
  --yes   do not ask for the confirmation, for a run with nobody to ask

The machine's root filesystem is kept. The chart retains the claim, and removing
it is a separate, deliberate command that this prints and does not run. There is
no flag here that does both.
EOF
}

# The claim holding this machine's root filesystem, found by the same label the
# machine itself is found by rather than by rebuilding the naming rule.
machine_claims() {
    kubectl_run get persistentvolumeclaims --selector "$(resolved_selector)" \
        --output 'go-template={{range .items}}{{.metadata.name}}{{"\n"}}{{end}}' 2>/dev/null || true
}

cmd_delete() {
    local name="" assume_yes=0
    while [ "$#" -gt 0 ]; do
        flag_split "$1"
        case "$SP_FLAG" in
            --help)
                delete_help
                return 0
                ;;
            --yes) assume_yes=1 ;;
            --*)
                common_flag "$@" || die "unknown flag for delete: $SP_FLAG"
                ;;
            *)
                [ -z "$name" ] || die "delete takes one machine, and was given $name and $SP_FLAG"
                name="$SP_FLAG"
                ;;
        esac
        shift "$SP_SHIFT"
    done
    [ -n "$name" ] || die "delete needs a machine's name. Run 'kubectl machine list' to see them."
    require_kubectl
    require_helm
    resolve_machine "$name"

    local claims claim_line
    claims="$(machine_claims)"
    if [ -n "$claims" ]; then
        claim_line=""
        while IFS= read -r claim || [ -n "$claim" ]; do
            [ -n "$claim" ] || continue
            claim_line="$claim_line $claim"
        done <<EOF
$claims
EOF
        claim_line="${claim_line# }"
    else
        claim_line=""
    fi

    printf 'Context:          %s\n' "$(current_context)"
    printf 'Namespace:        %s\n' "${SP_NAMESPACE:-(the one the context names)}"
    printf 'Machine:          %s\n' "$SP_MACHINE"
    printf 'Release:          %s\n' "$SP_MACHINE_RELEASE"
    printf 'Objects:          %s\n' "$SP_OBJECT"
    printf 'Root filesystem:  %s\n' "${claim_line:-(none found under this label)}"
    printf '\nThis removes the release. The root filesystem above is kept.\n'

    if [ "$assume_yes" -ne 1 ]; then
        local reply=""
        printf 'Type the name of the machine to confirm: ' >&2
        if ! IFS= read -r reply; then
            die "
nothing was confirmed, so nothing was removed. Pass --yes for a run with nobody to ask."
        fi
        [ "$reply" = "$SP_MACHINE" ] ||
            die "that is not the name of this machine, so nothing was removed."
    fi

    local args=(uninstall "$SP_MACHINE_RELEASE")
    [ -n "$SP_CONTEXT" ] && args+=(--kube-context "$SP_CONTEXT")
    [ -n "$SP_NAMESPACE" ] && args+=(--namespace "$SP_NAMESPACE")
    show_command helm "${args[@]}"
    helm "${args[@]}"

    printf '\nThe root filesystem was not removed: it is what makes this machine a pet, and
it outlives the release. To destroy it, and everything on it:\n\n'
    if [ -n "$claim_line" ]; then
        printf '  kubectl%s delete persistentvolumeclaim %s\n' "$(kube_flags)" "$claim_line"
    else
        printf '  kubectl%s get persistentvolumeclaim --selector %s\n' \
            "$(kube_flags)" "$(resolved_selector)"
    fi
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------

main() {
    require_platform

    [ "$#" -gt 0 ] || {
        usage
        return 0
    }

    local subcommand="$1"
    shift
    case "$subcommand" in
        list) cmd_list "$@" ;;
        status) cmd_status "$@" ;;
        shell) cmd_shell "$@" ;;
        console) cmd_console "$@" ;;
        create) cmd_create "$@" ;;
        delete) cmd_delete "$@" ;;
        version | --version) printf '%s %s\n' "$SP_PROGRAM" "$SP_VERSION" ;;
        help | --help)
            usage
            ;;
        *)
            die "$SP_PROGRAM has no command called $subcommand.

$(usage)"
            ;;
    esac
}

main "$@"
